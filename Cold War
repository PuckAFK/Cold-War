if game.PlaceId ~= KNOWN_PLACE_ID then
    warn(("[PuckAFK Cold War] Built for PlaceId %d; current PlaceId is %s. Continuing for same-game/subplace compatibility.")
        :format(KNOWN_PLACE_ID, tostring(game.PlaceId)))
