--// General helpers
local function connect(signal, callback)
    local connection = signal:Connect(callback)
    State.Connections[#State.Connections + 1] = connection
    return connection
end

local function normalizeDropdown(value)
    if type(value) == "table" then
        return value[1]
    end
    return value
end

local function clearTarget(mode)
    local target = State.Targets[mode]
    if not target then
        return
    end
    target.Player = nil
    target.Part = nil
    target.Point = nil
end

local function clearAllTargets()
    clearTarget("Aimbot")
    clearTarget("SilentAim")
end

local function safeRemoveDrawing(object)
    if not object then
        return
    end
    pcall(function()
        object.Visible = false
        object:Remove()
    end)
end

local function destroyHighlight(player)
    local highlight = State.Highlights[player]
    State.Highlights[player] = nil
    if highlight then
        pcall(function()
            highlight:Destroy()
        end)
    end
end

local function destroyESP(player)
    local bundle = State.Drawings[player]
    State.Drawings[player] = nil
    if bundle then
        for _, object in pairs(bundle) do
            safeRemoveDrawing(object)
        end
    end
    State.ESPVisibility[player] = nil
    destroyHighlight(player)
end

local function getCharacterData(player)
    if not player or player == LocalPlayer then
        return nil
    end

    local character = player.Character
    if not character or not character.Parent then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
        return nil
    end

    return character, humanoid, root
end

local COMBAT_TEAMS = {
    NATO = true,
    PACT = true,
}

local function teamName(player)
    local team = player and player.Team
    return team and tostring(team.Name) or ""
end

local function isEnemy(player, teamCheck)
    if not player or player == LocalPlayer then
        return false
    end
    if not teamCheck then
        return true
    end

    local localName = teamName(LocalPlayer)
    local otherName = teamName(player)

    -- Cold War uses NATO / PACT as combat teams and Neutral for non-combat.
    -- Never treat Neutral players as enemy combatants when team filtering is on.
    if COMBAT_TEAMS[localName] then
        return COMBAT_TEAMS[otherName] == true and otherName ~= localName
    end

    -- While the local player is Neutral/spectating, both real combat teams can
    -- still be visualized/selected without targeting other Neutral players.
    if localName == "Neutral" or localName == "" then
        return COMBAT_TEAMS[otherName] == true
    end

    local localTeam = LocalPlayer.Team
    local otherTeam = player.Team
    return localTeam ~= nil and otherTeam ~= nil and localTeam ~= otherTeam
end

local function getAimOrigin2D()
    Camera = workspace.CurrentCamera or Camera
    if not Camera then
        return Vector2.new(0, 0)
    end

    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        local viewport = Camera.ViewportSize
        return Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    end

    local mouse = UserInputService:GetMouseLocation()
    return Vector2.new(mouse.X, mouse.Y)
end

local function worldToScreen(position)
    Camera = workspace.CurrentCamera or Camera
    if not Camera then
        return nil, false, -1
    end

    local point, onScreen = Camera:WorldToViewportPoint(position)
    return Vector2.new(point.X, point.Y), onScreen, point.Z
end

-- R6 is the live game format; the extra names make the script resilient if a
-- character or subplace ever supplies an R15-style rig.
local BODY_PART_NAMES = {
    "Head",
    "Torso",
    "HumanoidRootPart",
    "Left Arm",
    "Right Arm",
    "Left Leg",
    "Right Leg",
    "UpperTorso",
    "LowerTorso",
    "LeftUpperArm",
    "RightUpperArm",
    "LeftUpperLeg",
    "RightUpperLeg",
}

local VISIBILITY_PART_NAMES = {
    "Head",
    "Torso",
    "UpperTorso",
    "HumanoidRootPart",
    "Left Arm",
    "Right Arm",
    "LeftUpperArm",
    "RightUpperArm",
}

local function getPreferredTargetPart(character, screenOrigin)
    local mode = Config.Aim.AimPoint

    if mode == "Closest Part" then
        local bestPart = nil
        local bestDistance = math.huge

        for _, name in ipairs(BODY_PART_NAMES) do
            local part = character:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                local screenPos, onScreen, depth = worldToScreen(part.Position)
                if screenPos and onScreen and depth > 0 then
                    local distance = (screenPos - screenOrigin).Magnitude
                    if distance < bestDistance then
                        bestDistance = distance
                        bestPart = part
                    end
                end
            end
        end

        return bestPart
    end

    if mode == "Upper Torso" or mode == "Torso" then
        return character:FindFirstChild("Torso")
            or character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("HumanoidRootPart")
            or character:FindFirstChild("Head")
    end

    return character:FindFirstChild("Head")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("HumanoidRootPart")
end

local function makeVisibilityParams()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    local filter = {}
    if LocalPlayer.Character then
        filter[#filter + 1] = LocalPlayer.Character
    end
    if Camera then
        filter[#filter + 1] = Camera
    end
    local ignore = workspace:FindFirstChild("Ignore")
    if ignore then
        filter[#filter + 1] = ignore
    end

    params.FilterDescendantsInstances = filter
    return params
end

local function hasLineOfSightFrom(origin, character, point)
    if typeof(origin) ~= "Vector3" or not character or typeof(point) ~= "Vector3" then
        return false
    end

    local direction = point - origin
    if direction.Magnitude <= 0.01 then
        return true
    end

    local result = workspace:Raycast(origin, direction, makeVisibilityParams())
    return result == nil
        or (result.Instance and result.Instance:IsDescendantOf(character))
end

local function cameraHasLineOfSight(character, point)
    Camera = workspace.CurrentCamera or Camera
    return Camera ~= nil and hasLineOfSightFrom(Camera.CFrame.Position, character, point)
end

local function getClosestVisibleBodyPart(character, screenOrigin, sourcePosition)
    local choices = {}

    for _, name in ipairs(BODY_PART_NAMES) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            local screenPos, onScreen, depth = worldToScreen(part.Position)
            if screenPos and onScreen and depth > 0 then
                choices[#choices + 1] = {
                    Part = part,
                    ScreenDistance = (screenPos - screenOrigin).Magnitude,
                }
            end
        end
    end

    table.sort(choices, function(a, b)
        return a.ScreenDistance < b.ScreenDistance
    end)

    for _, choice in ipairs(choices) do
        if hasLineOfSightFrom(sourcePosition, character, choice.Part.Position) then
            return choice.Part, choice.ScreenDistance
        end
    end

    return nil
end

--// Smoothed movement prediction
local function getTrackedVelocity(part)
    if not part or not part:IsA("BasePart") then
        return Vector3.new()
    end

    local rawVelocity = part.AssemblyLinearVelocity or Vector3.new()
    local now = os.clock()
    local sample = State.VelocitySamples[part]

    if not sample then
        sample = {
            Velocity = rawVelocity,
            Time = now,
        }
        State.VelocitySamples[part] = sample
        return rawVelocity
    end

    local dt = math.max(0, now - (sample.Time or now))
    sample.Time = now

    if dt > 0.25 then
        sample.Velocity = rawVelocity
        return rawVelocity
    end

    local smoothing = math.clamp((tonumber(Config.Aim.PredictionSmoothing) or 0) / 100, 0, 0.95)
    local baseAlpha = math.clamp(1 - smoothing, 0.05, 1)
    local frameFactor = math.max(dt * 60, 0.25)
    local alpha = 1 - ((1 - baseAlpha) ^ frameFactor)

    sample.Velocity = sample.Velocity:Lerp(rawVelocity, math.clamp(alpha, 0.02, 1))
    return sample.Velocity
end

local function clampPredictionOffset(offset)
    local maxOffset = math.max(0, tonumber(Config.Aim.MaxPredictionOffset) or 0)
    if maxOffset > 0 and offset.Magnitude > maxOffset then
        return offset.Unit * maxOffset
    end
    return offset
end

local function getCameraAimPoint(part)
    if not part or not part:IsA("BasePart") then
        return nil
    end

    local point = part.Position
    if Config.Aim.Prediction then
        local velocity = getTrackedVelocity(part)
        local predictionTime = math.max(0, tonumber(Config.Aim.PredictionTime) or 0)
        point = point + clampPredictionOffset(velocity * predictionTime)
    end
    return point
end

--// Shared target selection
local function modeFOV(mode)
    if mode == "SilentAim" then
        return math.max(1, tonumber(Config.Aim.SilentAimFOV) or 1)
    end
    return math.max(1, tonumber(Config.Aim.AimbotFOV) or 1)
end

local function targetStillValid(mode, player, fovMultiplier, sourcePosition)
    if not player or not State.Alive or not isEnemy(player, Config.Aim.TeamCheck) then
        return false, nil, nil
    end

    local character, _, root = getCharacterData(player)
    if not character then
        return false, nil, nil
    end

    Camera = workspace.CurrentCamera or Camera
    if not Camera then
        return false, nil, nil
    end

    local distance3D = (root.Position - Camera.CFrame.Position).Magnitude
    if distance3D > Config.Aim.MaxDistance then
        return false, nil, nil
    end

    local screenOrigin = getAimOrigin2D()
    local part = getPreferredTargetPart(character, screenOrigin)
    if not part then
        return false, nil, nil
    end

    local screenPos, onScreen, depth = worldToScreen(part.Position)
    if not screenPos or not onScreen or depth <= 0 then
        return false, nil, nil
    end

    local allowedFOV = modeFOV(mode) * (fovMultiplier or 1)
    local screenDistance = (screenPos - screenOrigin).Magnitude
    if screenDistance > allowedFOV then
        return false, nil, nil
    end

    if Config.Aim.VisibleCheck then
        local source = sourcePosition or Camera.CFrame.Position
        if not hasLineOfSightFrom(source, character, part.Position) then
            if Config.Aim.AimPoint ~= "Closest Part" then
                return false, nil, nil
            end

            local visiblePart, visibleDistance = getClosestVisibleBodyPart(character, screenOrigin, source)
            if not visiblePart or visibleDistance > allowedFOV then
                return false, nil, nil
            end
            part = visiblePart
        end
    end

    local point = mode == "Aimbot" and getCameraAimPoint(part) or part.Position
    return point ~= nil, part, point
end

local function selectBestTarget(mode, sourcePosition)
    Camera = workspace.CurrentCamera or Camera
    if not Camera then
        clearTarget(mode)
        return nil
    end

    local targetState = State.Targets[mode]
    local stickyMultiplier = math.max(1, tonumber(Config.Aim.StickyFOVMultiplier) or 1)

    if Config.Aim.StickyTarget and targetState.Player then
        local valid, part, point = targetStillValid(
            mode,
            targetState.Player,
            stickyMultiplier,
            sourcePosition
        )
        if valid then
            targetState.Part = part
            targetState.Point = point
            return targetState.Player, part, point
        end
    end

    local screenOrigin = getAimOrigin2D()
    local cameraPosition = Camera.CFrame.Position
    local maxFOV = modeFOV(mode)
    local maxDistance = math.max(0, tonumber(Config.Aim.MaxDistance) or 0)
    local candidates = {}

    -- Build/sort candidates before raycasting. In a full server this turns the
    -- visibility check from "raycast every player every frame" into "raycast
    -- the best few candidates until a valid target is found".
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player, Config.Aim.TeamCheck) then
            local character, _, root = getCharacterData(player)
            if character then
                local distance3D = (root.Position - cameraPosition).Magnitude
                if distance3D <= maxDistance then
                    local part = getPreferredTargetPart(character, screenOrigin)
                    if part then
                        local screenPos, onScreen, depth = worldToScreen(part.Position)
                        if screenPos and onScreen and depth > 0 then
                            local screenDistance = (screenPos - screenOrigin).Magnitude
                            if screenDistance <= maxFOV then
                                candidates[#candidates + 1] = {
                                    Player = player,
                                    Character = character,
                                    Part = part,
                                    ScreenDistance = screenDistance,
                                    Distance3D = distance3D,
                                    Score = screenDistance + (distance3D * 0.0005),
                                }
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.Score < b.Score
    end)

    local source = sourcePosition or cameraPosition

    for _, candidate in ipairs(candidates) do
        local part = candidate.Part
        local screenDistance = candidate.ScreenDistance

        if Config.Aim.VisibleCheck
            and not hasLineOfSightFrom(source, candidate.Character, part.Position) then

            if Config.Aim.AimPoint == "Closest Part" then
                part, screenDistance = getClosestVisibleBodyPart(
                    candidate.Character,
                    screenOrigin,
                    source
                )
            else
                part = nil
            end
        end

        if part and screenDistance <= maxFOV then
            local point = mode == "Aimbot" and getCameraAimPoint(part) or part.Position
            if point then
                targetState.Player = candidate.Player
                targetState.Part = part
                targetState.Point = point
                return candidate.Player, part, point
            end
        end
    end

    clearTarget(mode)
    return nil
end

local function rmbHeld()
    return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
end

local function aimbotActivationHeld()
    if not Config.Aim.Aimbot then
        return false
    end
    return not Config.Aim.HoldRMB or rmbHeld()
end

local function silentAimActivationHeld()
    if not Config.Aim.SilentAim then
        return false
    end
    return not Config.Aim.SilentAimHoldRMB or rmbHeld()
end

--// Cold War projectile-native silent aim
local function getWeaponName(toolOrName)
    if typeof(toolOrName) == "Instance" then
        return toolOrName.Name
    end
    if type(toolOrName) == "string" then
        return toolOrName
    end
    return nil
end

local function getTimeForDistance(speed, decay, distance)
    speed = tonumber(speed) or 0
    decay = math.max(0, tonumber(decay) or 0)
    distance = math.max(0, tonumber(distance) or 0)

    if distance <= 0 then
        return 0
    end
    if speed <= 0.000001 then
        return nil
    end

    if decay > 0.000001 then
        local maxForward = speed / decay
        if distance >= maxForward then
            return nil
        end

        local inside = 1 - (distance * decay / speed)
        if inside <= 0 then
            return nil
        end

        return -(1 / decay) * math.log(inside)
    end

    return distance / speed
end

local function getBulletSettings(toolOrName, muzzleIndex, bulletIndex)
    local manager = State.Ballistics.WeaponConfigManager
    local weaponName = getWeaponName(toolOrName)
    if not manager or not weaponName then
        return nil
    end

    local ok, muzzleConfig = pcall(function()
        return manager:GetMuzzleConfig(weaponName, muzzleIndex or 1)
    end)
    if not ok or type(muzzleConfig) ~= "table" then
        return nil
    end

    local bullets = muzzleConfig.BulletSettings
    local bullet = type(bullets) == "table" and bullets[bulletIndex or 1] or nil
    if type(bullet) ~= "table" then
        return nil
    end

    return bullet, muzzleConfig
end

local function getBallisticAimPoint(toolOrName, muzzleIndex, bulletIndex, origin, targetPart)
    local basePoint = targetPart.Position
    local bullet = getBulletSettings(toolOrName, muzzleIndex, bulletIndex)

    if not bullet then
        if Config.Aim.Prediction then
            return basePoint + clampPredictionOffset(
                getTrackedVelocity(targetPart) * math.max(0, Config.Aim.PredictionTime)
            )
        end
        return basePoint
    end

    local speed = tonumber(bullet.MuzzleVelocity) or 0
    local decay = math.max(0, tonumber(bullet.Drag) or 0)
    if speed <= 0 then
        return basePoint
    end

    local velocity = Config.Aim.Prediction and getTrackedVelocity(targetPart) or Vector3.new()
    local solved = basePoint

    -- The supplied place's Trajectory module uses:
    --   forward = speed/drag * (1 - exp(-drag*t))
    --   drop    = 0.5 * gravity * t^2
    -- Iterate because lead and drop slightly change the distance/time solution.
    for _ = 1, 3 do
        local distance = (solved - origin).Magnitude
        local travelTime = getTimeForDistance(speed, decay, distance)
        if not travelTime then
            break
        end

        travelTime = math.clamp(travelTime, 0, 3)

        local lead = Vector3.new()
        if Config.Aim.Prediction then
            lead = clampPredictionOffset(velocity * travelTime)
        end

        local dropCompensation = Vector3.new()
        if Config.Aim.BulletDropCompensation then
            dropCompensation = Vector3.new(
                0,
                0.5 * workspace.Gravity * travelTime * travelTime,
                0
            )
        end

        solved = basePoint + lead + dropCompensation
    end

    return solved
end

local function rotateDirection(vector, fromDirection, toDirection)
    if typeof(vector) ~= "Vector3"
        or typeof(fromDirection) ~= "Vector3"
        or typeof(toDirection) ~= "Vector3"
        or vector.Magnitude <= 0.000001
        or fromDirection.Magnitude <= 0.000001
        or toDirection.Magnitude <= 0.000001 then
        return vector
    end

    local from = fromDirection.Unit
    local to = toDirection.Unit
    local dot = math.clamp(from:Dot(to), -1, 1)

    if dot > 0.999999 then
        return vector.Unit
    end

    local axis = from:Cross(to)
    if axis.Magnitude < 0.000001 then
        axis = from:Cross(Vector3.new(0, 1, 0))
        if axis.Magnitude < 0.000001 then
            axis = from:Cross(Vector3.new(1, 0, 0))
        end
    end

    if axis.Magnitude < 0.000001 then
        return to
    end

    local rotation = CFrame.fromAxisAngle(axis.Unit, math.acos(dot))
    return rotation:VectorToWorldSpace(vector.Unit)
end

local function installSilentAim()
    if State.Ballistics.Installed or not State.Alive then
        return State.Ballistics.Installed
    end

    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
    local ballisticsClient = playerScripts and playerScripts:FindFirstChild("BallisticsClient")
    local clientFireModule = ballisticsClient and ballisticsClient:FindFirstChild("ClientFire")
    if not clientFireModule or not clientFireModule:IsA("ModuleScript") then
        return false
    end

    local okClientFire, ClientFire = pcall(require, clientFireModule)
    if not okClientFire or type(ClientFire) ~= "table" or type(ClientFire.fireVolley) ~= "function" then
        return false
    end

    local shared = ReplicatedStorage:FindFirstChild("Shared")
    local managerModule = shared and shared:FindFirstChild("WeaponConfigManager")
    if managerModule and managerModule:IsA("ModuleScript") then
        local okManager, manager = pcall(require, managerModule)
        if okManager and type(manager) == "table" then
            State.Ballistics.WeaponConfigManager = manager
        end
    end

    local original = ClientFire.fireVolley
    local wrapper

    wrapper = function(toolOrName, muzzleIndex, bulletIndex, origin, directions, options)
        if State.Alive
            and silentAimActivationHeld()
            and typeof(origin) == "Vector3"
            and type(directions) == "table"
            and #directions > 0 then

            local player, part = selectBestTarget("SilentAim", origin)
            if player and part and part.Parent then
                local desiredPoint = getBallisticAimPoint(
                    toolOrName,
                    muzzleIndex,
                    bulletIndex,
                    origin,
                    part
                )

                if desiredPoint then
                    local delta = desiredPoint - origin
                    if delta.Magnitude > 0.001 then
                        local desiredDirection = delta.Unit
                        local replacement = {}

                        if Config.Aim.PreserveSpread then
                            local average = Vector3.new()
                            local validDirections = 0

                            for i = 1, #directions do
                                local direction = directions[i]
                                if typeof(direction) == "Vector3" and direction.Magnitude > 0.000001 then
                                    average = average + direction.Unit
                                    validDirections = validDirections + 1
                                end
                            end

                            if validDirections > 0 and average.Magnitude > 0.000001 then
                                average = average.Unit
                                for i = 1, #directions do
                                    local direction = directions[i]
                                    if typeof(direction) == "Vector3" then
                                        replacement[i] = rotateDirection(direction, average, desiredDirection)
                                    else
                                        replacement[i] = direction
                                    end
                                end
                            else
                                for i = 1, #directions do
                                    replacement[i] = desiredDirection
                                end
                            end
                        else
                            for i = 1, #directions do
                                replacement[i] = desiredDirection
                            end
                        end

                        directions = replacement
                    end
                end
            end
        end

        return original(toolOrName, muzzleIndex, bulletIndex, origin, directions, options)
    end

    ClientFire.fireVolley = wrapper
    State.Ballistics.ClientFire = ClientFire
    State.Ballistics.OriginalFireVolley = original
    State.Ballistics.Wrapper = wrapper
    State.Ballistics.Installed = true
    return true
end

