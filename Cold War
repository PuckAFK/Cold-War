-- The supplied WEATHER/MINIMAP build binds WeatherScreenDroplets at Camera + 2.
-- Aim now runs at Camera + 3, after both recoil (+1) and weather (+2), avoiding
-- equal-priority fights while still running before Last-priority weapon/UI work.
RunService:BindToRenderStep(
    "PuckAFK_ColdWar_Aim",
    Enum.RenderPriority.Camera.Value + 3,
    function(dt)
        if not State.Alive then
            return
        end

        Camera = workspace.CurrentCamera or Camera
        if not Camera then
            return
        end

        local origin2D = getAimOrigin2D()

        if AimbotFOVCircle then
            AimbotFOVCircle.Visible = Config.Aim.Aimbot and Config.Aim.ShowAimbotFOV
            AimbotFOVCircle.Position = origin2D
            AimbotFOVCircle.Radius = Config.Aim.AimbotFOV
        end

        if SilentAimFOVCircle then
            SilentAimFOVCircle.Visible = Config.Aim.SilentAim and Config.Aim.ShowSilentAimFOV
            SilentAimFOVCircle.Position = origin2D
            SilentAimFOVCircle.Radius = Config.Aim.SilentAimFOV
        end

        if not aimbotActivationHeld() then
            clearTarget("Aimbot")
            return
        end

        local player, part, point = selectBestTarget("Aimbot")
        if not player or not part or not point then
            return
        end

        local cameraPosition = Camera.CFrame.Position
        local delta = point - cameraPosition
        if delta.Magnitude <= 0.001 then
            return
        end

        local desired = CFrame.lookAt(cameraPosition, point, Camera.CFrame.UpVector)
        local speed = math.max(1, tonumber(Config.Aim.AimSpeed) or 1)
        local alpha = 1 - math.exp(-speed * math.max(dt, 0))
        Camera.CFrame = Camera.CFrame:Lerp(desired, math.clamp(alpha, 0, 1))
    end
)

-- ESP render pass
connect(RunService.RenderStepped, function()
    if not State.Alive then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            updatePlayerESP(player)
        end
    end
end)

-- Lightweight user-facing status updater
local function targetText(target)
    if target and target.Player and target.Part then
        return target.Player.Name .. " · " .. target.Part.Name
    end
    return "none"
end

task.spawn(function()
    while State.Alive do
        if AimbotStatus and AimbotStatus.Set then
            if Config.Aim.Aimbot then
                AimbotStatus:Set("Aimbot target: " .. targetText(State.Targets.Aimbot))
            else
                AimbotStatus:Set("Aimbot: OFF")
            end
        end

        if SilentAimStatus and SilentAimStatus.Set then
            if not State.Ballistics.Installed then
                SilentAimStatus:Set("Silent Aim: loading weapon backend...")
            elseif Config.Aim.SilentAim then
                SilentAimStatus:Set("Silent Aim target: " .. targetText(State.Targets.SilentAim))
            else
                SilentAimStatus:Set("Silent Aim: OFF · ready")
            end
        end

        if ESPStatus and ESPStatus.Set then
            local enemies = 0
            for _, player in ipairs(Players:GetPlayers()) do
                if isEnemy(player, Config.ESP.TeamCheck) then
                    local character = getCharacterData(player)
                    if character then
                        enemies = enemies + 1
                    end
                end
            end

            ESPStatus:Set(
                (DrawingAvailable and "ESP ready" or "Chams ready")
                    .. " · enemies: " .. tostring(enemies)
            )
        end

        task.wait(0.35)
    end
end)

